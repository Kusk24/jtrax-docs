# Obsidian – user/workspace-specific, don't commit
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/

# OS
.DS_Store

# Generated by _workspace/reindex.py from the notes themselves. Deliberately
# not committed: every collaborator's hook rewrites it on every note write, so
# committing it would put a machine-written file that always differs into a
# single shared branch — a merge conflict on every pull, in a file nobody reads
# by hand. It is rebuilt in under two seconds.
INDEX.md
